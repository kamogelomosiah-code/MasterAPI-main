# Copy to .env and fill in. Never commit .env.

# Admin key for creating/managing apps (required in production, 16+ chars).
MASTER_KEY=change-me-to-a-long-random-string
# Signs your apps' user login tokens (required in production, 16+ chars).
TOKEN_SECRET=change-me-to-another-long-random-string

# MongoDB. Leave blank to store data in data/store.json (development only).
MONGODB_URI=
MONGODB_DB=masterapi

PORT=3000
# Browser origins allowed to call the API (comma-separated), or * for any.
CORS_ORIGINS=*
# Default requests per minute for new apps.
RATE_LIMIT_PER_MINUTE=120
# How long user logins last, in hours (default 168 = 7 days).
TOKEN_TTL_HOURS=168

# Optional: enables POST /api/v1/ai/chat
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Files service limits and agent settings (all optional)
# FILE_MAX_MB=10
# FILE_QUOTA_MB=100
# AGENT_PER_MINUTE=6
# WEB_PER_MINUTE=30
